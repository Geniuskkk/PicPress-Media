{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowJs": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "electron/**/*.ts",
    "forge.config.ts",
    "vite.*.config.ts",
    "scripts/verify-sidecar.mjs",
    "scripts/prepare-resources.mjs"
  ]
}
